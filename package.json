{
  "name": "@askeleven/sms-guard",
  "version": "0.1.0",
  "description": "Check a text message before an agent (or a person) sends it: GSM-7 or UCS-2, segment count, the recipient's local time, shorteners and opt-out wording. Splits long messages. CLI, library, and MCP server. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "AskEleven",
  "homepage": "https://github.com/askeleven/sms-guard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askeleven/sms-guard.git"
  },
  "bugs": {
    "url": "https://github.com/askeleven/sms-guard/issues"
  },
  "keywords": [
    "sms",
    "text-message",
    "gsm-7",
    "ucs-2",
    "sms-segments",
    "tcpa",
    "quiet-hours",
    "deliverability",
    "mcp",
    "mcp-server",
    "ai-agents"
  ],
  "bin": {
    "sms-guard": "bin/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build:types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build:types && npm test"
  },
  "types": "types/index.d.ts",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  }
}
